+package expo.modules.plugin
+
+import java.io.File
+import java.util.Properties
+
+object NodeBinary {
+  fun command(): String {
+    val fromEnv = System.getenv("NODE_BINARY")
+    if (!fromEnv.isNullOrBlank() && File(fromEnv).canExecute()) {
+      return fromEnv
+    }
+
+    nodeFromLocalProperties()?.let { return it }
+
+    return listOf("/opt/homebrew/bin/node", "/usr/local/bin/node")
+      .firstOrNull { File(it).canExecute() }
+      ?: "node"
+  }
+
+  private fun nodeFromLocalProperties(): String? {
+    val candidates = listOf(File("local.properties"), File("../local.properties"))
+    for (file in candidates) {
+      if (!file.exists()) continue
+      val properties = Properties()
+      file.inputStream().use { properties.load(it) }
+      val dir = properties.getProperty("nodejs.dir") ?: continue
+      val node = File(dir, "node")
+      if (node.canExecute()) {
+        return node.absolutePath
+      }
+    }
+    return null
+  }
+}
