+def resolveNodeBinary() {
+  def fromEnv = System.getenv("NODE_BINARY")
+  if (fromEnv && new File(fromEnv).canExecute()) {
+    return fromEnv
+  }
+  def localFile = new File(rootProject.projectDir, "local.properties")
+  if (localFile.exists()) {
+    def props = new Properties()
+    localFile.withInputStream { props.load(it) }
+    def dir = props.getProperty("nodejs.dir")
+    if (dir && new File(dir, "node").canExecute()) {
+      return new File(dir, "node").absolutePath
+    }
+  }
+  return ["/opt/homebrew/bin/node", "/usr/local/bin/node"].find { new File(it).canExecute() } ?: "node"
+}
 
